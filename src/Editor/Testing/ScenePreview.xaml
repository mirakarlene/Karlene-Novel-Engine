<UserControl x:Class="KNE.ScenePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KNE" MinHeight="180" Background="#FFF7F6FA">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel x:Name="PreviewToolbar" Margin="0,0,0,6">
            <WrapPanel DockPanel.Dock="Right">
                <CheckBox x:Name="FromMainInput" Content="От main" IsChecked="True" VerticalAlignment="Center" Margin="4,0,8,0" Checked="FromMain_Changed" Unchecked="FromMain_Changed" ToolTip="Учитывать предыдущие сцены и вызовы от начала игры. Снимите, чтобы проверить текущую функцию отдельно."/>
                <Button x:Name="SeekButton" Content="К выделению" Padding="8,4" Margin="4,0" Click="Seek_Click"/>
                <Button x:Name="ResetButton" Content="Сначала / сброс выборов" Padding="8,4" Margin="4,0" Click="Reset_Click"/>
                <Button x:Name="StepButton" Content="Шаг ›" Padding="8,4" Margin="4,0" Click="Step_Click" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock Text="Предпросмотр сцены" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="1" Background="#FF100A18" BorderBrush="#FFB6A6C8" BorderThickness="1">
            <Viewbox x:Name="SceneViewbox" Stretch="Uniform">
                <Grid Width="1280" Height="720">
                <Grid x:Name="SceneArea" Width="1280" Height="720" ClipToBounds="True">
                    <Grid x:Name="VisualLayer">
                    <Grid x:Name="ShaderBackgroundLayer">
                    <Border x:Name="DefaultBackground"/>
                    <local:AnimatedBackground x:Name="AnimatedBackdrop"/>
                    <Image x:Name="DefaultBackgroundImage" Stretch="UniformToFill"/>
                    <Image x:Name="BackgroundImage" Stretch="UniformToFill"/>
                    </Grid>
                    <Image x:Name="CharacterImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                    <Viewbox x:Name="MainScriptScreenViewbox" Stretch="Uniform" Visibility="Collapsed"><Canvas x:Name="MainScriptScreenCanvas" Width="1280" Height="720" IsHitTestVisible="False"/></Viewbox>
                    </Grid>
                    <Grid x:Name="ShaderUiLayer">
                    <TextBlock x:Name="SceneTitle" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="36" Foreground="White" Margin="48" IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Border x:Name="DialoguePanel" VerticalAlignment="Bottom" Visibility="Collapsed" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="SpeakerText" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Grid>
                                    <TextBlock x:Name="DialogueText" TextWrapping="Wrap"/>
                                    <local:EffectTextPresenter x:Name="DialogueEffects"/>
                                </Grid>
                                <StackPanel x:Name="ChoicePanel" Margin="0,12,0,0"/>
                                <local:TextInputPresenter x:Name="PlayerInput" Submitted="PlayerInput_Submitted"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Viewbox x:Name="ScriptScreenViewbox" Panel.ZIndex="20" Stretch="Uniform" Visibility="Collapsed"><Canvas x:Name="ScriptScreenCanvas" Width="1280" Height="720" IsHitTestVisible="False"/></Viewbox>
                    <local:ChoiceTimerPresenter x:Name="ChoiceTimer" Panel.ZIndex="25"/>
                    <Border x:Name="SceneFlash" Background="White" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
                </Grid>
            </Viewbox>
        </Border>
        <TextBlock x:Name="PreviewStatus" Grid.Row="2" Text="Выберите строку кода или блок." TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" Foreground="#FF536174" Margin="0,6,0,0"/>
    </Grid>
</UserControl>
