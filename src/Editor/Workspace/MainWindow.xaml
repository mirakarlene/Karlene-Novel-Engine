<Window x:Class="KNE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KNE"
        Title="Karlene Novel Engine" Height="950" Width="1500" MinHeight="700" MinWidth="1100" Background="{DynamicResource Editor.Background}"
        Loaded="Window_Loaded" Closed="Window_Closed" Closing="Window_Closing" PreviewKeyDown="MainWindow_PreviewKeyDown" PreviewMouseMove="WelcomePointer_Move" MouseLeave="WelcomePointer_Leave">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Theme.xaml"/><ResourceDictionary Source="../Themes/EditorStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
    <Grid x:Name="WelcomeBackdrop" IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=WelcomePanel}" Background="{DynamicResource Editor.WelcomeBackground}">
        <local:WelcomeBubbles x:Name="WelcomeBubbleField" Ink="{DynamicResource KNE.PinkBrush}" Accent="{DynamicResource KNE.AccentBrush}"/>
    </Grid>
    <DockPanel Margin="20" Background="Transparent">
        <TextBlock x:Name="OperationStatus" DockPanel.Dock="Bottom" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="FileCountStatus" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{DynamicResource Editor.Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=ProjectPanel}" Value="Visible"/><Condition Binding="{Binding Visibility, ElementName=FileBrowserPanel}" Value="Visible"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Grid>
            <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:WatercolorLogo x:Name="WelcomeLogo" Height="125" Width="960" HorizontalAlignment="Center" StartColor="{DynamicResource KNE.AccentColor}" EndColor="{DynamicResource KNE.PinkColor}" Margin="0,0,0,12" AutomationProperties.Name="Karlene Novel Engine"/>
                <TextBlock x:Name="WelcomeGreeting" Text="Добро пожаловать в KNE" FontSize="23" FontWeight="Medium" Foreground="{DynamicResource Editor.Subtitle}" TextAlignment="Center" Margin="0,0,0,24"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Button x:Name="CreateProjectButton" Content="Создать проект" Style="{StaticResource KNE.PrimaryButton}" Padding="20,12" Margin="5" Click="BtnCreateProject_Click"/>
                    <Button Content="Открыть проект" Padding="14,10" Margin="5" Click="BtnSelectProject_Click"/>
                    <Button Content="Настройки" Padding="14,10" Margin="5" Click="BtnSettings_Click"/>
                    <Button Content="Помощь" Padding="14,10" Margin="5" Click="BtnHelp_Click"/>
                </WrapPanel>
                <StackPanel Width="680" HorizontalAlignment="Center">
                <TextBlock x:Name="RecentProjectsHeading" Text="Последние проекты" FontSize="16" FontWeight="Bold" Margin="15,20,0,8"/>
                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RecentProjectsList">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <DockPanel Margin="5,3">
                            <Button DockPanel.Dock="Right" Content="×" Tag="{Binding Path}" ToolTip="Убрать из списка. Файлы проекта останутся." Width="30" Margin="6,0,0,0" Click="ForgetRecentProject_Click"/>
                            <Button Tag="{Binding Path}" ToolTip="{Binding Path}" HorizontalContentAlignment="Stretch" Padding="10,8" Click="OpenRecentProject_Click">
                                <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/><TextBlock Text="{Binding LastOpenedLabel}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Opacity" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Opacity" Value="0.4"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            </DockPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="ProjectPanel" Visibility="Collapsed" Background="{DynamicResource Editor.Background}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel x:Name="ProjectHeader" Margin="0,0,0,16">
                    <WrapPanel x:Name="PluginToolbar" DockPanel.Dock="Right"/>
                    <Button x:Name="AppearanceButton" DockPanel.Dock="Right" Content="Оформление" Padding="10,6" Click="BtnAppearance_Click"/>
                    <Button x:Name="SceneParametersButton" DockPanel.Dock="Right" Content="Параметры сцены" Margin="0,0,8,0" Padding="10,6" Click="SceneParameters_Click"/>
                    <Button x:Name="ProjectParametersButton" DockPanel.Dock="Right" Content="Параметры проекта" Margin="0,0,8,0" Padding="10,6" Click="ProjectParameters_Click"/>
                    <TextBlock x:Name="ProjectTitleTextBlock" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,0,10">
                        <TextBox x:Name="FileSearch" Padding="8" ToolTip="Поиск файлов по имени и относительному пути" AutomationProperties.Name="Поиск файлов" TextChanged="FileSearch_TextChanged"/>
                        <TextBlock Text="Поиск..." Margin="9,0" VerticalAlignment="Center" Foreground="{DynamicResource Editor.Text}" Opacity="0.5" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FileSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Grid>
                    <TabControl x:Name="DocumentTabs" Grid.Column="2" Margin="0,0,0,10" SelectionChanged="DocumentTabs_SelectionChanged" Visibility="Collapsed"/>
                    <TreeView x:Name="ProjectFilesTree" Grid.Row="1" SelectedItemChanged="ProjectFilesTree_SelectedItemChanged" MouseDoubleClick="OpenScript_DoubleClick">
                        <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/></Style></TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding RelativePath}"/>
                        </HierarchicalDataTemplate></TreeView.ItemTemplate>
                    </TreeView>
                    <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                <Grid x:Name="FileBrowserPanel" Grid.Row="1" Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="FileBrowserIntroduction" Text="В этом окне можно выбрать папку и файл, который вы хотите отредактировать. Чтоб перемещаться по папкам вы можете использовать либо файловый инспектор в панели слева, либо проводник в этом окне" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource Editor.Muted}"/>
                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button x:Name="FileBrowserBackButton" Content="← Назад" Visibility="Collapsed" DockPanel.Dock="Left" Padding="10,6" Margin="0,0,10,0" Click="FileBrowserBack_Click" ToolTip="На одну папку вверх"/>
                        <TextBox x:Name="FileBrowserPath" IsReadOnly="True" Padding="8,6" VerticalContentAlignment="Center" AutomationProperties.Name="Текущая папка проекта"/>
                    </DockPanel>
                <DataGrid x:Name="FilesDataGrid" Grid.Row="2" AutoGenerateColumns="False" Visibility="Collapsed"
                          MouseDoubleClick="OpenScript_DoubleClick" KeyDown="FileBrowser_KeyDown" SelectionChanged="BrowserSelection_Changed"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Имя файла" Width="*" SortMemberPath="DisplayName"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <DockPanel><Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="Путь" Binding="{Binding PathLabel, Mode=OneWay}" Width="2*"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Kind, Mode=OneWay}" Width="*"/>
                        <DataGridTemplateColumn Header="Действия" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding ProjectFile}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                    <ComboBox x:Name="FileActionInput" HorizontalAlignment="Stretch" SelectionChanged="FileActionsComboBox_SelectionChanged" Tag="{Binding ProjectFile}"
                                              ToolTip="Действия с файлом" AutomationProperties.Name="Действия с файлом">
                                        <ComboBoxItem Content="Редактировать"/>
                                        <ComboBoxItem Content="Переименовать"/>
                                        <ComboBoxItem Content="Дублировать"/>
                                        <ComboBoxItem Content="Переместить"/>
                                        <ComboBoxItem Content="Удалить"/>
                                    </ComboBox>
                                    <TextBlock Text="Действия…" Margin="9,0,28,0" VerticalAlignment="Center" Foreground="{DynamicResource Editor.Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=FileActionInput}" Value="-1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                    <ListBox x:Name="FileTiles" Grid.Row="2" SelectionChanged="BrowserSelection_Changed" MouseDoubleClick="OpenScript_DoubleClick" KeyDown="FileBrowser_KeyDown" PreviewMouseRightButtonDown="FileTiles_PreviewMouseRightButtonDown" ContextMenuOpening="FileTiles_ContextMenuOpening" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Файлы и папки проекта">
                        <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                            <!-- The stock disabled template paints a white background while workspace operations run. -->
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.Style>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="Width" Value="150"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Editor.Hover}"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Editor.Selection}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource KNE.AccentBrush}"/></Trigger>
                            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding PathLabel}">
                            <Image Source="{Binding Icon}" Width="48" Height="48" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center" MinHeight="32"/>
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                        <ListBox.ContextMenu><ContextMenu>
                            <MenuItem Header="Редактировать" Click="TileFileAction_Click"/><MenuItem Header="Переименовать" Click="TileFileAction_Click"/><MenuItem Header="Дублировать" Click="TileFileAction_Click"/><MenuItem Header="Переместить" Click="TileFileAction_Click"/><MenuItem Header="Удалить" Click="TileFileAction_Click"/>
                        </ContextMenu></ListBox.ContextMenu>
                    </ListBox>
                </Grid>
                    <Grid x:Name="EditorWorkspace" Grid.Row="1" Grid.Column="2" Visibility="Collapsed">
                        <local:ScriptEditor x:Name="SceneEditor" Visibility="Collapsed"
                            BlockLibraryRequested="SceneEditor_BlockLibraryRequested" TestSceneRequested="SceneEditor_TestSceneRequested" ExternalEditorRequested="SceneEditor_ExternalEditorRequested"
                            RunRequested="SceneEditor_RunRequested" MainSceneRequested="SceneEditor_MainSceneRequested" CloseRequested="SceneEditor_CloseRequested"/>
                    </Grid>
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
                    <WrapPanel x:Name="RunActionsGroup" DockPanel.Dock="Right" Margin="8,0,0,0">
                        <Button x:Name="AnalyzeProjectButton" Content="Анализ проекта" Padding="10,8" Margin="0,0,6,4" Click="BtnAnalyzeProject_Click"/>
                        <Button Content="Запустить проект" Padding="10,8" Margin="0,0,0,4" Click="BtnRunProject_Click"/>
                    </WrapPanel>
                    <WrapPanel>
                        <WrapPanel x:Name="ExitActionsGroup" Margin="0,0,12,0">
                            <Button Content="Главный экран" Padding="10,8" Margin="0,0,6,4" Click="BtnBack_Click"/>
                            <Button Content="Сохранить всё и выйти" Padding="10,8" Margin="0,0,0,4" Click="BtnSaveAllExit_Click"/>
                        </WrapPanel>
                        <WrapPanel x:Name="ImportActionsGroup" Margin="0,0,12,0">
                            <Button Content="Создать файл" Padding="8,8" Margin="0,0,6,4" Click="BtnCreateFile_Click"/>
                            <Button Content="Импорт файла" Padding="8,8" Margin="0,0,6,4" Click="BtnImportFile_Click"/>
                            <Button Content="Новая блок-схема" Padding="8,8" Margin="0,0,6,4" Click="BtnNewVisualScene_Click"/>
                            <Button Content="Импорт .rpy" Tag=".rpy" Padding="8,8" Margin="0,0,6,4" Click="BtnImportScript_Click"/>
                            <Button Content="Импорт .docx" Tag=".docx" Padding="8,8" Margin="0,0,0,4" Click="BtnImportScript_Click"/>
                        </WrapPanel>
                        <WrapPanel x:Name="FileViewActionsGroup">
                            <Button Content="Список файлов" Padding="8,8" Margin="0,0,6,4" Click="BtnFileList_Click"/>
                            <Button Content="Обновить" Padding="8,8" Margin="0,0,0,4" Click="BtnRefresh_Click"/>
                        </WrapPanel>
                    </WrapPanel>
                </DockPanel>
            </Grid>

            <Grid x:Name="SettingsPanel" Visibility="Collapsed" MaxWidth="1380" Margin="4">
                <Grid.Resources><local:AccessibilitySelectedConverter x:Key="AccessibilitySelected"/></Grid.Resources>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PreviousSettingsPageButton" Content="←" IsEnabled="False" Padding="14,8" Click="PreviousSettingsPage_Click" ToolTip="Предыдущая страница" AutomationProperties.Name="Предыдущая страница настроек"/>
                        <TextBlock x:Name="SettingsPageLabel" Text="1 / 2 · Основные" VerticalAlignment="Center" Margin="14,0"/>
                        <Button x:Name="NextSettingsPageButton" Content="→" Padding="14,8" Click="NextSettingsPage_Click" ToolTip="Следующая страница" AutomationProperties.Name="Следующая страница настроек"/>
                    </StackPanel>
                    <TextBlock Text="Настройки" FontSize="28" FontWeight="Bold"/>
                </DockPanel>
                <Viewbox x:Name="GeneralSettingsPage" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid Width="1300">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.6*" MinWidth="610"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="LeftSettingsColumn"><Border x:Name="ProjectsSettingsGroup" Background="{DynamicResource Editor.Surface}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="10" Padding="18" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Проекты" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,20"/>
                                <TextBlock Text="Путь к текстовому редактору" Margin="0,0,0,7"/>
                                <DockPanel><Button Content="Выбрать…" DockPanel.Dock="Right" Padding="10,6" Margin="8,0,0,0" Click="BtnSelectEditor_Click"/><TextBox x:Name="TxtEditorPath" MinWidth="120" Padding="6" VerticalContentAlignment="Center"/></DockPanel>
                                <TextBlock Text="Укажите .exe. Пустое поле — стандартный Блокнот." TextWrapping="Wrap" Foreground="{DynamicResource Editor.Muted}" Margin="0,8,0,22"/>
                                <TextBlock Text="Хранилище проектов" Margin="0,0,0,7"/>
                                <DockPanel><Button Content="Выбрать…" DockPanel.Dock="Right" Padding="10,6" Margin="8,0,0,0" Click="BtnSelectStorage_Click"/><TextBox x:Name="TxtProjectsStorage" MinWidth="120" Padding="6"/></DockPanel>
                                <TextBlock Text="Проекты создаются и обнаруживаются непосредственно в этой папке." TextWrapping="Wrap" Foreground="{DynamicResource Editor.Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="RenderSettingsGroup" Background="{DynamicResource Editor.Surface}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,12,0,0"><StackPanel><TextBlock Text="Рендер" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/><local:GraphicsSettingsEditor x:Name="AppGraphicsInput"/></StackPanel></Border></StackPanel>
                        <Border x:Name="DesignSettingsGroup" Grid.Column="2" Background="{DynamicResource Editor.Surface}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Дизайн KNE" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Имя пользователя" Margin="0,0,0,7"/><TextBox x:Name="TxtUserName" MaxLength="80" Padding="6" MinHeight="30"/><TextBlock Text="Необязательно. Для приветствия KNE." Foreground="{DynamicResource Editor.Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Тема оформления" Margin="0,0,0,7"/><ComboBox x:Name="ThemeInput" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="ThemeInput_SelectionChanged"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Летающие объекты главного экрана" Margin="0,0,0,7"/>
                                <ComboBox x:Name="WelcomeObjectInput" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="WelcomeObject_Changed" Margin="0,0,0,20"/>
                                <TextBlock Text="Доступность блоков" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                <TextBlock Text="Миниатюры показывают различия восприятия. Режим меняет палитру категорий и добавляет значки; оформление игры остаётся прежним." TextWrapping="Wrap" Foreground="{DynamicResource Editor.Muted}" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="AccessibilityCards">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <RadioButton GroupName="AccessibilityMode" Tag="{Binding Id}" Checked="Accessibility_Checked" Margin="0,0,7,7" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                            <RadioButton.IsChecked><MultiBinding Converter="{StaticResource AccessibilitySelected}" Mode="OneWay"><Binding Path="Id"/><Binding Path="(local:BlockAccessibility.Mode)" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/></MultiBinding></RadioButton.IsChecked>
                                            <RadioButton.Template><ControlTemplate TargetType="RadioButton"><Border x:Name="ModeCard" BorderBrush="{DynamicResource Editor.Border}" Background="{DynamicResource Editor.Background}" BorderThickness="1" CornerRadius="7" Padding="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ModeCard" Property="BorderBrush" Value="{DynamicResource KNE.AccentBrush}"/><Setter TargetName="ModeCard" Property="BorderThickness" Value="3"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeCard" Property="Background" Value="{DynamicResource Editor.Hover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModeCard" Property="BorderBrush" Value="{DynamicResource KNE.PinkBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></RadioButton.Template>
                                            <StackPanel><local:AccessibilityPreview Mode="{Binding Id}" Height="104" Margin="0,0,0,9"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Editor.Muted}" Margin="0,4,0,0"/></StackPanel>
                                        </RadioButton>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Отображение файлов проекта" Margin="0,12,0,7"/>
                                <ComboBox x:Name="ProjectBrowserViewInput" SelectedIndex="0" SelectedValuePath="Tag"><ComboBoxItem Content="Плитки" Tag="tiles"/><ComboBoxItem Content="Таблица" Tag="table"/></ComboBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Viewbox>
                <Grid x:Name="PluginsSettingsPage" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
                    <Border x:Name="PluginsSettingsGroup" Background="{DynamicResource Editor.Surface}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Плагины" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <Button x:Name="AddApplicationPluginButton" Content="Добавить…" Padding="12,6" Margin="0,0,8,0" Click="AddApplicationPlugin_Click"/>
                                        <Button x:Name="RemoveApplicationPluginButton" Content="Убрать из списка" Padding="12,6" Click="RemoveApplicationPlugin_Click">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ApplicationPluginsList}" Value="-1"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                    </WrapPanel>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock x:Name="ApplicationPluginsStatus" Foreground="{DynamicResource Editor.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock Text="C# и Lua. Изменения применяются после сохранения настроек. Удаление из списка оставляет файл на диске." Foreground="{DynamicResource Editor.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="ApplicationPluginsList" SelectionChanged="ApplicationPluginsList_SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Подключённые плагины KNE">
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,3" ToolTip="{Binding Path}"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{DynamicResource Editor.Muted}" FontSize="11" Margin="12,0,0,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding Path}" Foreground="{DynamicResource Editor.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    <Border x:Name="PluginDetailsGroup" Grid.Column="2" Background="{DynamicResource Editor.Surface}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="PluginNameText" Text="Выберите плагин" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <TextBlock Text="Автор" FontWeight="SemiBold"/><TextBlock x:Name="PluginAuthorText" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                <TextBlock Text="Дата создания" FontWeight="SemiBold"/><TextBlock x:Name="PluginCreatedAtText" Margin="0,4,0,12"/>
                                <TextBlock Text="Язык программирования" FontWeight="SemiBold"/><TextBlock x:Name="PluginLanguageText" Margin="0,4,0,12"/>
                                <TextBlock Text="Инструкция по использованию" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,8"/>
                                <TextBox x:Name="PluginReadmeText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"/>
                                <TextBlock Text="Лицензия" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
                                <TextBox x:Name="PluginLicenseText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"/>
                                <TextBlock x:Name="PluginMetadataStatus" Foreground="{DynamicResource Editor.Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Сохранить" Padding="18,10" Margin="0,0,10,0" Click="BtnSaveSettings_Click" Style="{StaticResource KNE.PrimaryButton}"/><Button Content="Назад" Padding="18,10" Click="BtnSettingsBack_Click"/></StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
        <Border x:Name="BlockLibraryOverlay" Visibility="Collapsed" Background="#B9181420" Padding="36" MouseDown="BlockLibraryBackdrop_Click"
                KeyboardNavigation.TabNavigation="Cycle">
            <ScrollViewer x:Name="BlockLibraryScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Border Background="{DynamicResource Editor.Surface}" CornerRadius="12" Padding="24" Width="1250" Height="700" VerticalAlignment="Center" HorizontalAlignment="Center"
                        MouseDown="BlockLibraryPanel_Click">
                    <local:BlockLibraryView x:Name="LibraryView" BlockSelected="Library_BlockSelected" CloseRequested="Library_CloseRequested"/>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
