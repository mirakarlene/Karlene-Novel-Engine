<Window x:Class="KNE.HelpChoicesWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Помощь" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <WrapPanel Margin="14" HorizontalAlignment="Center">
        <Button Width="148" Height="78" Margin="0,6,8,6" Click="Guide_Click" AutomationProperties.Name="Документация">
            <StackPanel>
                <Path Width="28" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Stroke="{DynamicResource Editor.Text}" StrokeThickness="1.5"
                      Data="M 14,5 C 10,2 6,2 2,3 L 2,20 C 7,19 11,20 14,22 C 17,20 21,19 26,20 L 26,3 C 22,2 18,2 14,5 M 14,5 L 14,22"/>
                <TextBlock Text="Документация" Margin="0,5,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button Width="148" Height="78" Margin="8,6,0,6" Click="Tutorials_Click" AutomationProperties.Name="Туториалы">
            <StackPanel>
                <Path Width="28" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Stroke="{DynamicResource Editor.Text}" StrokeThickness="1.5"
                      Data="M 2,3 H 26 V 21 H 2 Z M 11,7 L 19,12 L 11,17 Z"/>
                <TextBlock Text="Туториалы" Margin="0,5,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Button>
    </WrapPanel>
</Window>
