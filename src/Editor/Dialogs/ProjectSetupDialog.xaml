<Window x:Class="KNE.ProjectSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры нового проекта" Width="1040" Height="740"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource Editor.Background}">
    <Window.Resources>
        <ResourceDictionary Source="ProjectCreationCards.xaml"/>
    </Window.Resources>
    <Grid x:Name="SettingsPage" Margin="24">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
            <Grid Width="992" Height="640">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/><RowDefinition Height="308"/><RowDefinition Height="42"/><RowDefinition Height="80"/><RowDefinition Height="108"/><RowDefinition Height="22"/><RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Параметры нового проекта" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Editor.Text}"/>
                <UniformGrid x:Name="ResolutionCards" Grid.Row="1" Columns="4" Rows="2"/>
                <StackPanel x:Name="CustomResolutionFields" Grid.Row="2" Orientation="Horizontal" Margin="4,4,0,4" IsEnabled="False">
                    <TextBlock Text="Свой размер:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="CustomWidthInput" Text="1920" Width="84" VerticalContentAlignment="Center" AutomationProperties.Name="Ширина окна"/>
                    <TextBlock Text="×" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBox x:Name="CustomHeightInput" Text="1080" Width="84" VerticalContentAlignment="Center" AutomationProperties.Name="Высота окна"/>
                    <TextBlock Text="От 640×480 до 3840×2160" VerticalAlignment="Center" Margin="14,0" Opacity="0.65"/>
                </StackPanel>
                <Grid Grid.Row="3" Margin="4,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Графический API" FontWeight="SemiBold"/>
                        <ComboBox x:Name="GraphicsApiInput" DisplayMemberPath="Label" SelectedValuePath="Value" Margin="0,4,0,0"/>
                        <TextBlock Text="Если не знаете, оставьте по умолчанию" FontSize="11" Opacity="0.65" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ограничение FPS" FontWeight="SemiBold"/>
                        <ComboBox x:Name="FrameRateInput" DisplayMemberPath="Label" SelectedValuePath="Value" Margin="0,4,0,0"/>
                        <TextBlock Text="Если не знаете, оставьте по умолчанию" FontSize="11" Opacity="0.65" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Цветовая палитра" FontWeight="SemiBold" Margin="4,0"/>
                    <UniformGrid x:Name="PaletteCards" Grid.Row="1" Columns="5"/>
                </Grid>
                <TextBlock x:Name="SetupErrorText" Grid.Row="5" Foreground="#E46A83" TextWrapping="Wrap" FontSize="12" Margin="4,0"/>
                <DockPanel Grid.Row="6">
                    <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" Padding="18,4" Click="Cancel_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BackButton" Content="Назад" Padding="18,4" Margin="0,0,10,0" Click="Back_Click"/>
                        <Button x:Name="CreateButton" Content="Создать проект" IsDefault="True" Padding="22,4" Click="Create_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
