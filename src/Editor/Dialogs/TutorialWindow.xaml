<Window x:Class="KNE.TutorialWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Туториалы" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="TutorialMode" TargetType="RadioButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource Editor.Hover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource KNE.AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Editor.Text}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <Border Background="{DynamicResource Editor.Background}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1"
                Padding="2" CornerRadius="10" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TraditionalMode" Content="Традиционный код" IsChecked="True"
                             GroupName="TutorialMode" Style="{StaticResource TutorialMode}"/>
                <RadioButton x:Name="VisualNodesMode" Content="Визуальные ноды"
                             GroupName="TutorialMode" Style="{StaticResource TutorialMode}"/>
            </StackPanel>
        </Border>
        <Button x:Name="TutorialPlaceholder" Width="148" Height="82" Margin="0,14,0,0" Click="Placeholder_Click"
                AutomationProperties.Name="Туториалы готовятся">
            <TextBlock Text="…" FontSize="26"/>
        </Button>
        <Button Content="Закрыть" IsCancel="True" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="12,5"/>
    </StackPanel>
</Window>
