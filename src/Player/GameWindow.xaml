<Window x:Class="KNE.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:KNE"
        Title="Karlene Novel Engine" Height="720" Width="1280" MinWidth="640" MinHeight="480"
        Background="#FF201134" Loaded="Window_Loaded" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="GameTextBrush" Color="#FFF5EEFF"/>
        <SolidColorBrush x:Key="GameAccentBrush" Color="#FFD3ACFF"/>
        <SolidColorBrush x:Key="GameButtonBrush" Color="#EB3C2654"/>
        <DataTemplate x:Key="ChoiceLabelTemplate"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource GameTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GameButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GameAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="SceneArea" ClipToBounds="True" SizeChanged="SceneArea_SizeChanged">
            <Grid x:Name="VisualLayer">
            <Border x:Name="DefaultBackground"/>
            <local:AnimatedBackground x:Name="AnimatedBackdrop"/>
            <Image x:Name="DefaultBackgroundImage" Stretch="UniformToFill"/>
            <Image x:Name="BackgroundImage" Stretch="UniformToFill"/>
            <Image x:Name="CharacterImage" Stretch="Uniform" Width="420" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            <Viewbox x:Name="MainScriptScreenViewbox" Stretch="Uniform" Visibility="Collapsed"><Canvas x:Name="MainScriptScreenCanvas" Width="1280" Height="720"/></Viewbox>
            </Grid>
            <TextBlock x:Name="SceneTitle" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="36" Foreground="{DynamicResource GameTextBrush}" Margin="48" IsHitTestVisible="False" Visibility="Collapsed"/>
            <Border x:Name="DialoguePanel" VerticalAlignment="Bottom" Height="240"
                    Background="#ED21162F" BorderBrush="#FF8E60B5" BorderThickness="1" CornerRadius="16" Margin="28" Padding="24"
                    MouseLeftButtonUp="Dialogue_Click" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="SpeakerText" FontSize="20" FontWeight="SemiBold" Foreground="#FFD3ACFF" Margin="0,0,0,10"/>
                            <Grid>
                                <TextBlock x:Name="DialogueText" FontSize="24" TextWrapping="Wrap" Foreground="#FFF5EEFF"/>
                                <local:EffectTextPresenter x:Name="DialogueEffects"/>
                            </Grid>
                            <StackPanel x:Name="ChoicePanel" Margin="0,16,0,0"/>
                            <local:TextInputPresenter x:Name="PlayerInput" Submitted="PlayerInput_Submitted"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="NextButton" Grid.Row="1" Content="Далее  ›" HorizontalAlignment="Right" Padding="24,8" Margin="0,12,0,0"
                            Click="NextButton_Click" IsEnabled="False"/>
                </Grid>
            </Border>
            <Viewbox x:Name="ScriptScreenViewbox" Panel.ZIndex="20" Stretch="Uniform" Visibility="Collapsed"><Canvas x:Name="ScriptScreenCanvas" Width="1280" Height="720"/></Viewbox>
            <Border x:Name="SceneFlash" Background="White" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <StackPanel x:Name="GameControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24" Visibility="Collapsed">
            <Button x:Name="SaveButton" Content="Сохранить" Padding="14,7" Margin="0,0,8,0" Click="SaveButton_Click" IsEnabled="False"/>
            <Button x:Name="LoadButton" Content="Загрузить" Padding="14,7" Margin="0,0,8,0" Click="LoadButton_Click" IsEnabled="False"/>
            <Button x:Name="LoadAutoButton" Content="Автосохранение" Tag="auto" Padding="14,7" Margin="0,0,8,0" Click="LoadButton_Click" IsEnabled="False"/>
            <Button x:Name="PauseButton" Content="Меню" Padding="14,7" Click="PauseButton_Click"/>
        </StackPanel>
        <Border x:Name="MenuOverlay" Background="#AA160D24">
            <Grid>
            <ScrollViewer x:Name="MenuScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalAlignment="Center"
                          MaxHeight="{Binding ActualHeight, ElementName=SceneArea}">
                <StackPanel x:Name="MenuPanel" Width="420" Margin="32">
                    <TextBlock x:Name="MenuTitle" Text="Моя новелла" Foreground="{DynamicResource GameTextBrush}" FontSize="44" FontWeight="Light" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MenuSubtitle" Foreground="{DynamicResource GameTextBrush}" FontSize="16" Opacity="0.7" TextWrapping="Wrap" Margin="0,12,0,32"/>
                    <Button x:Name="ResumeButton" Content="Вернуться к игре" Visibility="Collapsed" Margin="0,0,0,12" Click="ResumeButton_Click"/>
                    <Button x:Name="StartButton" Content="Начать игру" Margin="0,0,0,12" Click="StartButton_Click"/>
                    <Button x:Name="ContinueButton" Content="Продолжить" Margin="0,0,0,12" Click="ContinueButton_Click"/>
                    <Button x:Name="ExitButton" Content="Выйти" Click="ExitButton_Click"/>
                    <TextBlock Text="F11 — полный экран" Foreground="{DynamicResource GameTextBrush}" Opacity="0.45" FontSize="12" Margin="0,28,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
            <Viewbox x:Name="ScreenViewbox" Stretch="Uniform"><Canvas x:Name="ScreenCanvas" Width="1280" Height="720"/></Viewbox>
            <Border x:Name="SaveBrowserPanel" Visibility="Collapsed" Width="540" MaxHeight="{Binding ActualHeight, ElementName=SceneArea}" VerticalAlignment="Center" Padding="24" Background="#F0201530" CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="Сохранения" Foreground="{DynamicResource GameTextBrush}" FontSize="28" Margin="0,0,0,16"/>
                    <ListBox x:Name="SaveSlotsList" Height="220" SelectionChanged="SaveSlot_Changed" Background="Transparent"
                             Foreground="{DynamicResource GameTextBrush}" BorderBrush="{DynamicResource GameAccentBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding Slot}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="14" Opacity="0.8" Margin="0,4,0,4"/>
                                <TextBlock Text="{Binding ModifiedLabel}" FontSize="12" Opacity="0.65"/>
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="SlotBorder" Background="Transparent" CornerRadius="8" Margin="4"><ContentPresenter/></Border>
                                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SlotBorder" Property="Background" Value="{DynamicResource GameButtonBrush}"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBox x:Name="SaveSlotName" Text="slot-1" Padding="8" Margin="0,12,0,12" ToolTip="Имя ручного слота"/>
                    <WrapPanel>
                        <Button x:Name="SaveSelectedButton" Content="Записать слот" Click="SaveSelected_Click" Margin="0,0,8,8"/>
                        <Button x:Name="LoadSelectedButton" Content="Загрузить" Click="LoadSelected_Click" Margin="0,0,8,8"/>
                        <Button x:Name="DeleteSelectedButton" Content="Удалить" Click="DeleteSelected_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <Button Content="Назад" Click="ScreenBack_Click"/>
                </StackPanel>
            </Border>
            </Grid>
        </Border>
        <Border x:Name="DebugOverlay" Panel.ZIndex="10" VerticalAlignment="Top" Background="#F0181024" BorderBrush="#FF8E60B5" BorderThickness="1" Padding="16" Margin="16" Visibility="Collapsed">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Закрыть консоль" Padding="12,5" Margin="8,0,0,0" Click="CloseConsole_Click"/>
                    <Button x:Name="StopButton" DockPanel.Dock="Right" Content="Остановить" Padding="12,5" Click="StopButton_Click" IsEnabled="False"/>
                    <TextBlock x:Name="StatusText" Text="Подготовка игры…" Foreground="White" TextWrapping="Wrap" Margin="0,0,16,8"/>
                </DockPanel>
                <Grid Height="140">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="ConsoleOutputScroll" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ConsoleOutput" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#FFDDDDDD"/>
                    </ScrollViewer>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Переменные проекта" Foreground="#FFD3ACFF" Margin="0,0,0,4"/>
                        <TextBox x:Name="VariablesOutput" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" Foreground="#FFDDDDDD" Background="Transparent" BorderThickness="0"
                                 ToolTip="Глобальные переменные и локальные переменные активных корутин. Обновляются во время выполнения."/>
                    </Grid>
                </Grid>
                <TextBox x:Name="CommandInput" Margin="0,10,0,0" Padding="6" KeyDown="CommandInput_KeyDown" IsEnabled="False"
                         FontFamily="Consolas" FontSize="14" ToolTip="Команда отладки: Enter. F3 — закрыть журнал."/>
            </StackPanel>
        </Border>
        <Border x:Name="NoticePanel" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#ED21162F" CornerRadius="8" Margin="24" Padding="14,8" Visibility="Collapsed" MaxWidth="420">
            <TextBlock x:Name="NoticeText" Foreground="{DynamicResource GameTextBrush}" TextWrapping="Wrap"/>
        </Border>
        <Border x:Name="StartupErrorOverlay" Background="#FF201134" Padding="32" Visibility="Collapsed">
            <Grid MaxWidth="960">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Ошибка игры" Foreground="#FFF5EEFF" FontSize="32" TextWrapping="Wrap"/>
                    <TextBlock Text="Проверьте подробности ошибки и выберите действие ниже." Foreground="#FFD3ACFF" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
                <TextBox x:Name="StartupErrorMessage" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         MinHeight="100" Padding="16" FontFamily="Consolas" FontSize="16"
                         Foreground="#FFF5EEFF" Background="#FF2B1A40" BorderBrush="#FF8E60B5"/>
                <StackPanel Grid.Row="2" Margin="0,24,0,0">
                    <WrapPanel>
                        <Button x:Name="StartupErrorExitButton" Content="Выйти" Margin="0,0,8,8" Click="ExitButton_Click"/>
                        <Button x:Name="ErrorRestartButton" Content="Перезапуск" Margin="0,0,8,8" Click="ErrorRestart_Click" ToolTip="Начать игру заново с открытой консолью и переменными проекта."/>
                        <Button x:Name="ErrorReturnButton" Content="Вернуться" Margin="0,0,8,8" Click="ErrorReturn_Click" IsEnabled="False" ToolTip="Вернуться к последнему корректному сегменту после ошибки перехода между функциями."/>
                        <Button x:Name="ErrorMarkdownButton" Content="Сохранить отчёт в Markdown" Margin="0,0,8,8" Click="ErrorMarkdown_Click" ToolTip="Скопировать раздел «Подробности» в буфер обмена в формате Markdown."/>
                        <Button x:Name="ErrorConsoleButton" Content="Консоль" Margin="0,0,8,8" Click="ErrorConsole_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="ErrorActionStatus" Foreground="#FFD3ACFF" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
