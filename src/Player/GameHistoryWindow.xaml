<Window x:Class="KNE.GameHistoryWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История" Width="640" Height="480" MinWidth="360" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ListBox x:Name="Entries" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6">
                        <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ChoiceLabel" Text="Выбранный ответ" Opacity="0.8" Visibility="Collapsed"/>
                        <TextBlock x:Name="BranchLabel" Text="Отменено откатом" Opacity="0.8" Visibility="Collapsed"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Choice}" Value="True"><Setter TargetName="ChoiceLabel" Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding RolledBack}" Value="True"><Setter TargetName="BranchLabel" Property="Visibility" Value="Visible"/></DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Empty" Text="История пока пуста." HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Button Content="Закрыть" IsCancel="True" Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="12,5"/>
    </Grid>
</Window>
