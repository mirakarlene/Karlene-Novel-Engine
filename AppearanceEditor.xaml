<UserControl x:Class="KNE.AppearanceEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:KNE" Background="#FFF4F2F7" FontFamily="Segoe UI" FontSize="13">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
  <WrapPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
   <Button x:Name="SaveAppearanceButton" Content="Сохранить оформление" Click="Save_Click" Padding="12,6" Margin="0,0,8,0"/>
   <Button x:Name="UndoAppearanceButton" Content="Отменить" Click="Undo_Click" Padding="12,6" Margin="0,0,8,0"/>
   <Button x:Name="RedoAppearanceButton" Content="Повторить" Click="Redo_Click" Padding="12,6" Margin="0,0,8,0"/>
   <Button x:Name="PreviewMotionButton" Content="Просмотр движения" Click="PreviewMotion_Click" Padding="12,6"/>
  </WrapPanel>
  <StackPanel Grid.Row="1" Margin="0,0,10,0">
   <TextBlock Text="Экраны" FontWeight="Bold" Margin="0,0,0,6"/>
   <ListBox x:Name="ScreensList" Height="190" SelectionChanged="Screens_Changed"/>
   <TextBox x:Name="ScreenName" Margin="0,8,0,6" ToolTip="Имя экрана"/>
   <ComboBox x:Name="ScreenRole" Margin="0,0,0,6" ToolTip="Роль экрана" DisplayMemberPath="Label" SelectedValuePath="Value"/>
   <WrapPanel>
    <Button x:Name="AddScreenButton" Content="Добавить" Click="AddScreen_Click" Margin="0,0,4,4"/>
    <Button Content="Имя" Click="RenameScreen_Click" Margin="0,0,4,4"/>
    <Button x:Name="DeleteScreenButton" Content="Удалить" Click="DeleteScreen_Click"/>
   </WrapPanel>
   <TextBlock Text="Элементы · снизу вверх" FontWeight="Bold" Margin="0,14,0,6"/>
   <ListBox x:Name="ElementsList" Height="160" SelectionChanged="Elements_Changed"/>
   <ComboBox x:Name="NewElementType" SelectedIndex="0" Margin="0,8,0,6"><ComboBoxItem Content="Кнопка" Tag="button"/><ComboBoxItem Content="Текст" Tag="text"/><ComboBoxItem Content="Панель" Tag="panel"/><ComboBoxItem Content="Изображение" Tag="image"/><ComboBoxItem Content="Переключатель" Tag="toggle"/><ComboBoxItem Content="Ползунок" Tag="slider"/><ComboBoxItem Content="Список сохранений" Tag="save_list"/><ComboBoxItem Content="Имя слота" Tag="save_name"/></ComboBox>
   <WrapPanel><Button Content="+ Элемент" Click="AddElement_Click"/><Button Content="−" Click="DeleteElement_Click" Margin="4,0"/><Button x:Name="RaiseLayerButton" Content="↑" Click="RaiseLayer_Click"/><Button Content="↓" Click="LowerLayer_Click" Margin="4,0"/></WrapPanel>
   <TextBlock Text="Сцена игры управляется Lua и блоками. Здесь меняется оформление экранов вне геймплея." TextWrapping="Wrap" Foreground="Gray" Margin="0,14,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Viewbox Stretch="Uniform">
    <Grid Width="1280" Height="720" ClipToBounds="True">
     <Border x:Name="PreviewBackground"/><local:AnimatedBackground x:Name="AnimatedPreview"/>
     <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
     <Canvas x:Name="DesignCanvas" Width="1280" Height="720" Background="Transparent"
       PreviewMouseLeftButtonDown="Canvas_Down" PreviewMouseMove="Canvas_Move" PreviewMouseLeftButtonUp="Canvas_Up" LostMouseCapture="Canvas_LostCapture"/>
    </Grid>
   </Viewbox>
   <TextBlock Grid.Row="1" Text="Перетащите элемент. X/Y и вектор движения — в координатах холста 1280×720." TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"/>
  </Grid>
  <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="Свойства элемента" FontWeight="Bold"/>
    <TextBlock Text="Текст · {{title}} — название игры" Margin="0,8,0,4"/><TextBox x:Name="ElementText" AcceptsReturn="True" MinHeight="44" TextWrapping="Wrap"/>
    <TextBlock Text="Действие" Margin="0,8,0,4"/><ComboBox x:Name="ElementAction" DisplayMemberPath="Label" SelectedValuePath="Value"/>
    <TextBlock Text="Целевой экран" Margin="0,8,0,4"/><ComboBox x:Name="TargetScreen" DisplayMemberPath="Name" SelectedValuePath="Id"/>
    <TextBlock Text="Путь изображения от проекта" Margin="0,8,0,4"/><TextBox x:Name="ElementImage"/>
    <UniformGrid Columns="2" Margin="0,8,0,0">
     <StackPanel><TextBlock Text="X"/><TextBox x:Name="ElementX"/></StackPanel><StackPanel><TextBlock Text="Y"/><TextBox x:Name="ElementY"/></StackPanel>
     <StackPanel><TextBlock Text="Ширина"/><TextBox x:Name="ElementWidth"/></StackPanel><StackPanel><TextBlock Text="Высота"/><TextBox x:Name="ElementHeight"/></StackPanel>
     <StackPanel><TextBlock Text="Шрифт"/><TextBox x:Name="ElementFont"/></StackPanel><StackPanel><TextBlock Text="Порядок движения"/><TextBox x:Name="MotionOrder"/></StackPanel>
     <StackPanel><TextBlock Text="Вектор X"/><TextBox x:Name="MotionX"/></StackPanel><StackPanel><TextBlock Text="Вектор Y"/><TextBox x:Name="MotionY"/></StackPanel>
     <StackPanel><TextBlock Text="Задержка, с"/><TextBox x:Name="MotionDelay"/></StackPanel><StackPanel><TextBlock Text="Длительность, с"/><TextBox x:Name="MotionDuration"/></StackPanel>
    </UniformGrid>
    <CheckBox x:Name="MotionLoop" Content="Цикл туда и обратно" Margin="0,8,0,8"/>
    <Button x:Name="ApplyElementButton" Content="Применить элемент" Click="ApplyElement_Click" Padding="8"/>
    <Separator Margin="0,12"/>
    <TextBlock Text="Фон проекта" FontWeight="Bold"/>
    <TextBlock Text="Палитра" Margin="0,8,0,4"/><ComboBox x:Name="PaletteChoice" DisplayMemberPath="Label" SelectedValuePath="Value"/>
    <TextBlock Text="Узор" Margin="0,8,0,4"/><ComboBox x:Name="PatternChoice" DisplayMemberPath="Label" SelectedValuePath="Value"/>
    <TextBlock Text="Цвет фона / узора" Margin="0,8,0,4"/><TextBox x:Name="BackgroundColor"/><TextBox x:Name="PatternColor" Margin="0,4,0,0"/>
    <TextBlock Text="Кастомный фон (путь или пусто)" Margin="0,8,0,4"/><TextBox x:Name="BackgroundPath"/>
    <CheckBox x:Name="AnimateBackground" Content="Движение фона" Margin="0,8,0,8"/>
    <UniformGrid Columns="2"><StackPanel><TextBlock Text="Скорость 0.1–3"/><TextBox x:Name="AnimationSpeed"/></StackPanel><StackPanel><TextBlock Text="Амплитуда 0–80"/><TextBox x:Name="WaveAmplitude"/></StackPanel></UniformGrid>
    <Button x:Name="ApplyThemeButton" Content="Применить палитру / фон" Click="ApplyTheme_Click" Margin="0,8,0,0" Padding="8"/>
   </StackPanel>
  </ScrollViewer>
  <TextBlock x:Name="EditorStatus" Grid.Row="2" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </Grid>
</UserControl>
