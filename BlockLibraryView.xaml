<UserControl x:Class="KNE.BlockLibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button x:Name="CloseLibraryButton" DockPanel.Dock="Right" Content="Закрыть · Esc" Click="Close_Click" Padding="12,7"/>
            <StackPanel><TextBlock Text="Добавить блок" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Выберите группу и команду. Блок появится в центре видимой области схемы." Foreground="#5A6273" TextWrapping="Wrap" Margin="0,6,16,0"/></StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="BlockGroups" SelectionChanged="Group_Changed" BorderThickness="0" Background="#F1F0F6" Padding="4" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{Binding Color}" BorderThickness="4,0,0,0" Padding="10,14"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Grid.Column="2">
                <TextBox x:Name="BlockSearch" DockPanel.Dock="Top" Margin="0,0,0,12" Padding="8" TextChanged="Search_Changed" ToolTip="Поиск в выбранной группе" AutomationProperties.Name="Поиск блока"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="EmptyLibraryText" Text="В этой группе ничего не найдено." Foreground="#5A6273" Margin="8" Visibility="Collapsed"/>
                        <WrapPanel x:Name="BlockCards"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
