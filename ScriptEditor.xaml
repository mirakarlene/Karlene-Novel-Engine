<UserControl x:Class="KNE.ScriptEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KNE"
             PreviewKeyDown="Editor_KeyDown" Background="White">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="DocumentTitle" Text="Выберите сценарий в дереве и нажмите «Открыть сценарий»." TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,6"/>
            <WrapPanel>
                <Button x:Name="SaveButton" Content="Сохранить" Padding="8,5" Margin="0,0,5,4" Click="Save_Click" IsEnabled="False"/>
                <Button x:Name="RunButton" Content="Предпросмотр сегмента" Padding="8,5" Margin="0,0,5,4" Click="Run_Click" IsEnabled="False"/>
                <Button x:Name="ExternalEditorButton" Content="Внешний редактор" Padding="8,5" Margin="0,0,5,4" Click="ExternalEditor_Click" Visibility="Collapsed"/>
                <Button x:Name="MainSceneButton" Content="Сделать главной" Padding="8,5" Margin="0,0,5,4" Click="MainScene_Click" IsEnabled="False"/>
                <Button x:Name="ExportButton" Content="Копия как KRL…" Padding="8,5" Margin="0,0,5,4" Click="Export_Click" IsEnabled="False"/>
                <Button x:Name="UndoButton" Content="Отменить" Padding="8,5" Margin="0,0,5,4" Click="Undo_Click" IsEnabled="False"/>
                <Button x:Name="RedoButton" Content="Повторить" Padding="8,5" Margin="0,0,5,4" Click="Redo_Click" IsEnabled="False"/>
                <Button x:Name="CloseDocumentButton" Content="Закрыть" Padding="8,5" Margin="0,0,5,4" Click="CloseDocument_Click" IsEnabled="False"/>
            </WrapPanel>
        </StackPanel>
        <local:KrlCodeEditor x:Name="CodeEditor" Grid.Row="1" Visibility="Collapsed"
                 FontFamily="Consolas" FontSize="14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 TextChanged="Code_TextChanged" SelectionChanged="Code_SelectionChanged"/>
        <Grid x:Name="GraphPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Функция" VerticalAlignment="Center" Margin="0,0,5,4"/>
                    <TextBox x:Name="FunctionNameInput" Width="130" Margin="0,0,8,4" ToolTip="Имя функции этой блок-схемы. main — единственная точка старта игры."/>
                    <ComboBox x:Name="BlockType" Width="140" Margin="0,0,5,4" DisplayMemberPath="Title"/>
                    <Button x:Name="AddBlockButton" Content="+ Блок" Padding="8,4" Margin="0,0,8,4" Click="Add_Click"/>
                    <TextBlock Text="Масштаб" VerticalAlignment="Center" Margin="0,0,5,4"/>
                    <Slider x:Name="ZoomSlider" Minimum="0.4" Maximum="1.5" Value="1" Width="75" ValueChanged="Zoom_Changed" Margin="0,0,0,4"/>
                </WrapPanel>
                <ScrollViewer x:Name="GraphScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFF0F3F7">
                    <Canvas x:Name="GraphCanvas" Width="1600" Height="1000" Background="Transparent" PreviewMouseWheel="Canvas_MouseWheel">
                        <Canvas.LayoutTransform><ScaleTransform x:Name="CanvasScale"/></Canvas.LayoutTransform>
                    </Canvas>
                </ScrollViewer>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PropertiesPanel" IsEnabled="False">
                    <TextBlock x:Name="SelectedTitle" Text="Свойства блока" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel x:Name="SpeakerField"><TextBlock Text="Говорящий (пусто — рассказчик)" TextWrapping="Wrap"/><TextBox x:Name="SpeakerInput" Margin="0,3,0,8"/></StackPanel>
                    <StackPanel x:Name="TextField"><TextBlock Text="Текст / вопрос"/><TextBox x:Name="SceneTextInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,3,0,8"/></StackPanel>
                    <StackPanel x:Name="OptionsField"><TextBlock Text="Ответы — по одному на строку" TextWrapping="Wrap"/><TextBox x:Name="OptionsInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Margin="0,3,0,8"/></StackPanel>
                    <StackPanel x:Name="PathField"><TextBlock x:Name="PathLabel" Text="Путь от корня проекта"/><TextBox x:Name="PathInput" Margin="0,3,0,8"/><Button x:Name="BrowsePathButton" Content="Выбрать ресурс…" Click="BrowseResource_Click" Margin="0,0,0,8"/></StackPanel>
                    <StackPanel x:Name="PositionField"><TextBlock Text="Позиция"/><ComboBox x:Name="PositionInput" Margin="0,3,0,8"><ComboBoxItem Content="left"/><ComboBoxItem Content="center"/><ComboBoxItem Content="right"/></ComboBox></StackPanel>
                    <CheckBox x:Name="LoopInput" Content="Повторять музыку" Margin="0,0,0,8"/>
                    <CheckBox x:Name="PreviewAnimationInput" Content="Анимация при выделении блока" ToolTip="Проигрывать анимацию фона проекта в предпросмотре. Без флажка кадр неподвижен." Margin="0,0,0,8" Checked="PreviewAnimation_Changed" Unchecked="PreviewAnimation_Changed"/>
                    <TextBlock x:Name="TransitionHelp" Foreground="#FF536174" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <StackPanel x:Name="VariableField"><TextBlock Text="Переменная state"/><TextBox x:Name="VariableInput" Margin="0,3,0,8"/><TextBlock Text="Тип значения"/><ComboBox x:Name="ValueTypeInput" Margin="0,3,0,8" DisplayMemberPath="Label" SelectedValuePath="Value"/><TextBlock Text="Значение"/><TextBox x:Name="ValueInput" Margin="0,3,0,8"/></StackPanel>
                    <StackPanel x:Name="ComparisonField"><TextBlock Text="Сравнение"/><ComboBox x:Name="ComparisonInput" Margin="0,3,0,8" DisplayMemberPath="Label" SelectedValuePath="Value"/></StackPanel>
                    <Button x:Name="ApplyPropertiesButton" Content="Применить свойства" Click="Apply_Click" Padding="8,5" Margin="0,0,0,6"/>
                    <Button x:Name="DeleteBlockButton" Content="Удалить блок" Click="Delete_Click" Padding="8,5" Margin="0,0,0,8"/>
                    <TextBlock Text="Связь: нажмите выход блока, затем вход другого. Правая кнопка по выходу удаляет связь. Заголовок блока можно перетаскивать. Ctrl+колесо меняет масштаб." Foreground="#FF536174" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" Foreground="#FF536174" Margin="0,0,8,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <RadioButton x:Name="CodeMode" Content="Код" GroupName="EditorMode" Margin="8,0" Checked="Mode_Changed" IsEnabled="False"/>
                <RadioButton x:Name="GraphMode" Content="Блок-схема" GroupName="EditorMode" Checked="Mode_Changed" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
