<Window x:Class="KNE.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KRL Game" Height="650" Width="960" MinWidth="480" MinHeight="360"
        Background="#FF2D2D30" Loaded="Window_Loaded" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="ChoiceLabelTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" Text="Подготовка игры…" Foreground="White"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel>
                <Button x:Name="StopButton" Content="Остановить" Padding="12,5" Margin="0,0,6,4"
                        Click="StopButton_Click" IsEnabled="False"/>
                <Button x:Name="SaveButton" Content="Сохранить" Padding="10,5" Margin="0,0,6,4"
                        Click="SaveButton_Click" IsEnabled="False"/>
                <Button x:Name="LoadButton" Content="Загрузить" Padding="10,5" Margin="0,0,6,4"
                        Click="LoadButton_Click" IsEnabled="False"/>
                <Button x:Name="LoadAutoButton" Content="Автосохранение" Tag="auto" Padding="10,5"
                        Margin="0,0,0,4" Click="LoadButton_Click" IsEnabled="False"/>
            </WrapPanel>
        </StackPanel>
        <Grid x:Name="SceneArea" Grid.Row="1" ClipToBounds="True">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill"/>
            <Image x:Name="CharacterImage" Stretch="Uniform" Width="300"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            <Border VerticalAlignment="Bottom" MaxHeight="{Binding ActualHeight, ElementName=SceneArea}"
                    Background="#DD202025" CornerRadius="8" Padding="24"
                    MouseLeftButtonUp="Dialogue_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="SpeakerText" FontSize="20" FontWeight="Bold"
                                       Foreground="#FF8CC8FF" Margin="0,0,0,12"/>
                            <TextBlock x:Name="DialogueText" FontSize="23" TextWrapping="Wrap" Foreground="White"/>
                            <StackPanel x:Name="ChoicePanel" Margin="0,20,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="NextButton" Grid.Row="1" Content="Далее  ›" HorizontalAlignment="Right"
                            Padding="24,10" Margin="0,16,0,0" Click="NextButton_Click" IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
        <Expander Grid.Row="2" Header="Журнал" Foreground="White" Margin="0,10,0,0">
            <ScrollViewer x:Name="ConsoleOutputScroll" Height="140" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ConsoleOutput" TextWrapping="Wrap" FontFamily="Consolas"
                           FontSize="12" Foreground="#FFDDDDDD"/>
            </ScrollViewer>
        </Expander>
        <TextBox x:Name="CommandInput" Grid.Row="3" Margin="0,10,0,0" Padding="6"
                 KeyDown="CommandInput_KeyDown" IsEnabled="False" FontFamily="Consolas" FontSize="14"
                 ToolTip="Команда отладки: Enter"/>
    </Grid>
</Window>

